CREATE PROCEDURE ps_students_insert(IN count INT)
BEGIN
    DECLARE i INT DEFAULT 1;
    DECLARE full_name VARCHAR(200);

    -- Цикл заполнения таблицы
    WHILE i <= count DO

        -- Получаем случайное ФИО из функции
        SET full_name = fn_random_student_name();

        -- Добавляем студента
        INSERT INTO students(first_name, last_name)
        VALUES(
            SUBSTRING_INDEX(full_name, ' ', 1),
            SUBSTRING_INDEX(full_name, ' ', -1)
        );

        -- Увеличиваем счётчик
        SET i = i + 1;

    END WHILE;

END






































CREATE PROCEDURE ps_shedule_insert (IN count int)
BEGIN
	DECLARE i int default 1;
    DECLARE d int default 1;
    
    WHILE i <= count DO
		IF d = 8 THEN
			SET d = 1;
		end if;
        INSERT INTO shedule(day_name, date_day)
        VALUES(
			ELIT(d, 'понедельник', 'вторник', 'среда', 'четверг', 'пятница', 'суббота', 'воскресенье'),
            NOW()
		);
        SET d = d + 1;
        SET i = i + 1;
	end while;

END









USE academy;

CREATE TABLE IF NOT EXISTS shedule(
	id int primary key auto_increment,
    day_name varchar(100) not null,
    date_day date
);

CREATE TABLE IF NOT EXISTS teacher(
	id int primary key auto_increment,
    full_name varchar(100) not null,
    email varchar(100) unique,
    phone varchar(100) unique,
    employment_date date
);


CREATE TABLE IF NOT EXISTS courses(
	id int primary key auto_increment,
	courses_name varchar(100) not null,
    specialiti varchar(100) not null,
    crated_at date
);

CREATE TABLE IF NOT EXISTS classes(
	id int primary key auto_increment,
    class_name varchar(100) not null,
    course_id int not null,
    student_count tinyint,
    created_id date,
    foreign key (course_id) references courses(id)
);

CREATE TABLE IF NOT EXISTS grades(
	id int primary key auto_increment,
    grade int
);

CREATE TABLE IF NOT EXISTS student_groups(
	id int primary key auto_increment,
    group_name varchar(50)
);

CREATE TABLE IF NOT EXISTS student(
	id int primary key auto_increment,
    first_name varchar(100),
    last_name varchar(100)
);

CREATE TABLE IF NOT EXISTS subjects(
	id int primary key auto_increment,
    subject_name varchar(50)
);
